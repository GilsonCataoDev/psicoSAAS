NODE_ENV=development
PORT=3001

# ─── Banco de dados ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/psicosaas

# ─── Autenticação JWT ──────────────────────────────────────────────────────
# Gerar com: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# ─── Assinatura digital de documentos ─────────────────────────────────────
# Gerar com: openssl rand -hex 32
# NUNCA alterar em produção — invalida todas as assinaturas existentes!
SIGN_SECRET=your-sign-secret-key-change-in-production-min-32-chars

# ─── Asaas (pagamentos SaaS) ───────────────────────────────────────────────
# Sandbox: https://sandbox.asaas.com → Minha Conta → Integrações → Chave API
# Produção: https://asaas.com → Minha Conta → Integrações → Chave API
ASAAS_API_KEY=$aact_SEU_TOKEN_AQUI
# Opcional. Se omitido, NODE_ENV=production usa produção; demais ambientes usam sandbox.
# ASAAS_BASE_URL=https://api.asaas.com/v3

# Token secreto configurado em: Asaas → Configurações → Webhooks → Token de acesso
ASAAS_WEBHOOK_TOKEN=seu-token-webhook-secreto

# ─── E-mail transacional (Resend) ─────────────────────────────────────────
# https://resend.com → API Keys → Criar chave
# Domínio verificado necessário para produção (ex: @seudominio.com.br)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=PsicoSaaS <noreply@seudominio.com.br>

# ─── WhatsApp (Evolution API) ─────────────────────────────────────────────
# Self-hosted: https://github.com/EvolutionAPI/evolution-api
# Ou serviço gerenciado: https://uazapi.com / https://wppconnect.io
WHATSAPP_API_URL=https://your-evolution-api.com
WHATSAPP_API_KEY=your-api-key
WHATSAPP_INSTANCE=psicosaas-instance

# ─── URLs ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://gilsoncataodev.github.io,http://usecognia.com.br,http://www.usecognia.com.br,https://usecognia.com.br,https://www.usecognia.com.br

# ─── Beta ─────────────────────────────────────────────────────────────────
# Padrao: true. Defina false quando quiser voltar a bloquear acesso sem assinatura.
BETA_FREE_ACCESS=true

# ─── Monitoramento de erros (Sentry) ──────────────────────────────────────
# https://sentry.io → Criar projeto Node.js → Copiar DSN
# Deixar vazio em desenvolvimento para não enviar erros locais
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXXXX.ingest.sentry.io/XXXXXXX

# ─── Criptografia de anotações clínicas (AES-256) ─────────────────────────
# Gerar com: openssl rand -hex 32
ENCRYPTION_KEY=change-this-encryption-secret-min-32-chars

# ─── Object Storage para avatares (Cloudflare R2 ou AWS S3) ──────────────
# Sem essas vars, avatares são salvos como base64 no banco (modo legado).
# Cloudflare R2: https://dash.cloudflare.com → R2 → Criar bucket
#   STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS S3: remova STORAGE_ENDPOINT (usa endpoint padrão da região)
STORAGE_ENDPOINT=
STORAGE_BUCKET=usecognia-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_CDN_URL=https://cdn.usecognia.com.br
STORAGE_REGION=auto

# ─── Anexos clínicos: driver de armazenamento (opcional) ──────────────────
# Padrão "postgres" (base64 criptografado no banco, comportamento atual).
# "r2" usa o bucket privado acima (STORAGE_* sem precisar de STORAGE_CDN_URL)
# — NUNCA use um bucket/CDN público para anexos clínicos. Anexos existentes
# não são migrados automaticamente ao trocar de driver.
ATTACHMENTS_STORAGE_DRIVER=postgres

# ─── Heartbeats de monitoramento (Better Stack, opcional) ─────────────────
# https://betterstack.com/uptime → criar um heartbeat monitor → copiar a URL
# Sem essas vars, os jobs rodam normalmente sem enviar heartbeat nenhum.
# Uma falha de heartbeat nunca interrompe a tarefa principal (lembretes etc).
BETTERSTACK_HEARTBEAT_REMINDER_URL=
BETTERSTACK_HEARTBEAT_PAYMENT_URL=

# ─── Radar de Psicólogos (prospecção B2B interna) ─────────────────────────
# Ferramenta administrativa de descoberta de leads via busca web autorizada.
# Desligada por padrão — nada roda automaticamente sem essa flag.
PROSPECTING_ENABLED=false
# mock (padrão, sem custo/rede) ou http (provider real configurável abaixo)
PROSPECTING_SEARCH_PROVIDER=mock
# Chave de uma API de busca web autorizada (ex: Bing Web Search API ou similar).
PROSPECTING_SEARCH_API_KEY=
# Endpoint GET da API de busca; resposta esperada em JSON { results: [{title,url,snippet}] }.
PROSPECTING_SEARCH_BASE_URL=
PROSPECTING_MAX_RESULTS_PER_RUN=100
# Score mínimo (0-100) para um lead ser marcado como "qualified" após análise.
PROSPECTING_MIN_SCORE=60
# Dias de retenção de um lead não utilizado antes da expiração automática (LGPD).
PROSPECTING_RETENTION_DAYS=180
# Intervalo mínimo entre requisições ao mesmo domínio durante o crawling.
PROSPECTING_CRAWL_DELAY_MS=3000
PROSPECTING_MAX_PAGES_PER_DOMAIN=3
PROSPECTING_USER_AGENT=UseCogniaProspectingBot/1.0
# E-mail de contato exibido para quem quiser reportar o bot (boa prática de crawling).
PROSPECTING_CONTACT_EMAIL=

# ─── Transcrição e IA (opcionais) ────────────────────────────────────────
# Transcrição via Groq Whisper (gratuito, ~7200s/dia): https://console.groq.com
GROQ_API_KEY=
# Fallback: transcrição via OpenAI Whisper (pago): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Resumo sugestivo via Claude Haiku: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Franquia compartilhada por resumo de sessão, prontuário e rascunho de documento.
# Use 0 para desativar novos textos por IA no plano correspondente.
AI_TEXT_ESSENCIAL_MONTHLY_LIMIT=30
AI_TEXT_PRO_MONTHLY_LIMIT=150

# ─── Copiloto de Raciocínio Clínico Neuropsicológico (plano Pro) ──────────
# Franquia mensal de análises por conta. 0 desativa o recurso para todas as contas.
NEUROPSYCH_AI_MONTHLY_LIMIT=30
# Tamanho máximo (caracteres) do registro clínico montado antes de virar prompt.
NEUROPSYCH_AI_MAX_INPUT_CHARS=20000
# Teto de tokens de saída pedidos ao provedor por análise.
NEUROPSYCH_AI_MAX_OUTPUT_TOKENS=3000
# Timeout da chamada ao provedor de IA, em milissegundos.
NEUROPSYCH_AI_TIMEOUT_MS=30000
# Orçamento global mensal do Copiloto (todas as contas somadas), em dólares.
# Ao ser atingido, novas análises ficam bloqueadas até o próximo mês.
NEUROPSYCH_AI_GLOBAL_MONTHLY_BUDGET_USD=50

# Expiracao opcional dos links do portal do paciente (em dias). Vazio = links nao expiram.
PORTAL_TOKEN_TTL_DAYS=30
