# Ambiente local para rodar a suíte E2E do Copiloto Neuropsicológico
# (frontend/e2e/neuropsych-copilot*.ts) contra um backend + Postgres locais.
#
# Uso:
#   cp .env.e2e.example .env.e2e-local
#   # edite se necessário, depois:
#   set -a && . ./.env.e2e-local && set +a && npx nest start
#
# .env.e2e-local é ignorado pelo git (ver .gitignore) — nunca commitar a
# cópia real, mesmo sendo só valores fake/locais.
#
# NUNCA aponta para produção. Todos os segredos abaixo são placeholders
# locais — não são credenciais reais e não funcionam contra nenhum serviço.

NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://postgres@localhost:5544/usecognia_e2e

JWT_SECRET=e2e-local-jwt-secret-not-for-production-min-32-chars
SIGN_SECRET=e2e-local-sign-secret-not-for-production-min-32
ENCRYPTION_KEY=e2e-local-encryption-key-not-for-prod-32chars

ASAAS_API_KEY=disabled
ASAAS_WEBHOOK_TOKEN=e2e-local-webhook-token

RESEND_API_KEY=disabled
RESEND_FROM=noreply@example.com

FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

BETA_FREE_ACCESS=true

# Concede plano Pro sem passar por cobrança — só para esta conta de teste E2E.
COMPED_PRO_EMAILS=e2e.copilot@example.com

# Copiloto Neuropsicológico — limites baixos de propósito para exercitar os
# testes de limite/orçamento rapidamente, e mock do provedor ativado (nunca
# chama a Anthropic de verdade). NEUROPSYCH_AI_MOCK_PROVIDER só tem efeito
# quando NODE_ENV !== 'production' — ver AiService.generateNeuropsychAnalysis.
NEUROPSYCH_AI_MOCK_PROVIDER=true
NEUROPSYCH_AI_MONTHLY_LIMIT=30
NEUROPSYCH_AI_MAX_INPUT_CHARS=20000
NEUROPSYCH_AI_MAX_OUTPUT_TOKENS=3000
NEUROPSYCH_AI_TIMEOUT_MS=5000
NEUROPSYCH_AI_GLOBAL_MONTHLY_BUDGET_USD=50
