{
  "name": "usecognia-frontend",
  "version": "0.1.0",
  "androidVersionCode": 1,
  "private": true,
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/gen-seo-assets.mjs && node scripts/gen-blog-og-images.mjs",
    "build": "tsc && vite build",
    "postbuild": "node scripts/create-spa-fallbacks.mjs && node scripts/prerender-blog.mjs",
    "preview": "vite preview",
    "preview:dist": "node scripts/serve-dist.mjs",
    "lint": "eslint src --ext ts,tsx",
    "test:unit": "vitest run src",
    "test:news-automation": "node --test scripts/publish-daily-news.test.mjs",
    "audit:prod": "node scripts/audit-production.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "cap:sync": "npm run build && cap sync",
    "cap:sync:ios": "npm run build && cap sync ios && node scripts/fix-ios-package-paths.mjs",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:build:android": "npm run cap:sync && node scripts/build-android-debug.mjs",
    "cap:build:android:release": "npm run cap:sync && node scripts/build-android-release.mjs",
    "cap:install:android": "node scripts/install-android-debug.mjs",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "gen:og": "node scripts/gen-og-image.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.1",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.20.0",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.441.0",
    "posthog-js": "^1.422.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.87.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "7.18.3",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "serialize-javascript": "^7.0.5",
    "brace-expansion": "5.0.9",
    "dompurify": "^3.4.13",
    "browserslist": "^4.28.7",
    "@xmldom/xmldom": "^0.9.12",
    "postcss-selector-parser": "^6.1.3",
    "fast-uri": "^3.1.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "serialize-javascript": "^7.0.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.0"
  }
}
