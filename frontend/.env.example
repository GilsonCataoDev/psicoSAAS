# ─── API Backend ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api

# ─── Modo mock (sem backend) ───────────────────────────────────────────────
# "true" usa dados fictícios localmente — nunca usar em produção
VITE_USE_MOCK=false

# ─── Analytics (PostHog; só carrega após consentimento) ──────────────────
# https://posthog.com → Criar projeto → Project Settings → Project API Key
# Deixar vazio para desabilitar analytics (ex: em desenvolvimento)
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ─── Google Ads (consent-gated; só carrega após consentimento) ──────────────
# 1. Crie uma conta em https://ads.google.com
# 2. VITE_GOOGLE_ADS_ID: Menu → Ferramentas → Google Tag → ID do tag (ex: AW-1234567890)
# 3. VITE_GOOGLE_ADS_CONV_LEAD: Meta → Conversões → nova ação "Lead" → send_to (ex: AW-1234567890/AbCdEf...)
# 4. VITE_GOOGLE_ADS_CONV_REGISTER: idem para ação "Cadastro" (dispara no final do trial signup)
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_CONV_LEAD=
VITE_GOOGLE_ADS_CONV_REGISTER=

# ─── Base URL (GitHub Pages) ──────────────────────────────────────────────
# Só necessário para deploy em subpath (ex: /psicosaas/)
# BASE_URL=/psicosaas/

# ─── Beta ────────────────────────────────────────────────────────────────
# Padrão: true. Defina false para reativar a tela comercial de planos.
VITE_BETA_MODE=true
