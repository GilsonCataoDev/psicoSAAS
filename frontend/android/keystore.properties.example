# Copie este arquivo para "keystore.properties" (mesma pasta) e preencha com
# os valores reais. NUNCA commite o keystore.properties real nem o arquivo
# .jks/.keystore — ambos ja estao no .gitignore.
#
# Como gerar o keystore (rode uma vez, na sua maquina, com JDK instalado):
#   keytool -genkeypair -v -keystore usecognia-release.keystore -alias usecognia -keyalg RSA -keysize 2048 -validity 10000
#
# Guarde o arquivo .keystore gerado E as senhas num gerenciador de senhas —
# perder qualquer um dos dois impede atualizar o app publicado pra sempre.

storeFile=../usecognia-release.keystore
storePassword=TROQUE_ESTA_SENHA
keyAlias=usecognia
keyPassword=TROQUE_ESTA_SENHA
